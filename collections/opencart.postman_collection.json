      "name": "login",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "id": "9098a979-5a5f-4488-8771-eccccd150fef",
            "exec": [
              "pm.collectionVariables.set(\"base_url\", \"http://192.168.1.16/opencart-3.0.3.8/upload/index.php?route=\");\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "id": "4d4dca81-6710-4738-8eb2-dd833e609072",
            "exec": [
              "pm.test(\"Collection variable 'base_url' is created and valid\", function () {\r",
              "    const baseUrl = pm.collectionVariables.get(\"base_url\");\r",
              "    \r",
              "    // Optional: Verify it matches your exact local OpenCart URL\r",
              "    pm.expect(baseUrl).to.eql(\"http://192.168.1.16/opencart-3.0.3.8/upload/index.php?route=\");\r",
              "\r",
              "});\r",
              "\r",
              "// Log the value to the Postman Console for quick visual confirmation\r",
              "\r",
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "pm.test(\"response time is less than 40ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(40);\r",
              "});\r",
              "var jsonData = pm.response.json();\r",
              "pm.collectionVariables.set(\"apitoken\", jsonData.api_token); // store token in collection variable for future use\r",
              "pm.test(\"Response contains success message and a token\", function () {\r",
              "pm.expect(jsonData.success).to.include(\"API session successfully started\");\r",
              "\r",
              "});\r",
              "pm.test(\"Collection variable 'apitoken' is created and valid\", function () {\r",
              "   pm.expect(jsonData.api_token).to.not.be.null;  // when postman sends null\r",
              "pm.expect(jsonData.api_token).to.not.be.undefined; // when postman sends nothing\r",
              "\r",
              "\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
