    {
      "name": "getcontent",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "4fec774f-83b7-4b5e-9b0d-ff6d23c555c4",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"response time is less than 200ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(200);\r",
              "});\r",
              "var responseJson = pm.response.json();\r",
              "pm.collectionVariables.set(\"cartid\", responseJson.products[0].cart_id);\r",
              "pm.test(\"Collection variable 'cartid' matches response cart_id\", function () {\r",
              "    const cid = pm.collectionVariables.get(\"cartid\");\r",
              "    const responseCartId = responseJson.products[0].cart_id;\r",
              "    \r",
              "    // Convert both to strings to avoid strict type mismatch failures (e.g., \"123\" vs 123)\r",
              "    pm.expect(cid.toString()).to.eql(responseCartId.toString());\r",
              "});\r",
              "\r",
              "// Define your expected database schema and types\r",
              "const schema = {\r",
              "    \"type\": \"object\",\r",
              "    \"properties\": {\r",
              "        \"products\": {\r",
              "            \"type\": \"array\",\r",
              "            \"items\": {\r",
              "                \"type\": \"object\",\r",
              "                \"properties\": {\r",
              "                    \"cart_id\": { \"type\": \"string\" },\r",
              "                    \"product_id\": { \"type\": \"string\" },\r",
              "                    \"name\": { \"type\": \"string\" },\r",
              "                    \"model\": { \"type\": \"string\" },\r",
              "                    \"option\": { \"type\": \"array\" },\r",
              "                    \"quantity\": { \"type\": \"string\" },\r",
              "                    \"stock\": { \"type\": \"boolean\" },\r",
              "                    \"shipping\": { \"type\": \"string\" },\r",
              "                    \"price\": { \"type\": \"string\" },\r",
              "                    \"total\": { \"type\": \"string\" },\r",
              "                    \"reward\": { \"type\": \"integer\" }\r",
              "                },\r",
              "                \"required\": [\r",
              "                    \"cart_id\",\r",
              "                    \"product_id\",\r",
              "                    \"name\",\r",
              "                    \"model\",\r",
              "                    \"option\",\r",
              "                    \"quantity\",\r",
              "                    \"stock\",\r",
              "                    \"shipping\",\r",
              "                    \"price\",\r",
              "                    \"total\",\r",
              "                    \"reward\"\r",
              "                ]\r",
              "            }\r",
              "        }\r",
              "        },\r",
              "        };\r",
              "// Validate response against the schema using Postman's built-in pm.response.to.have.jsonSchema()\r",
              "pm.test(\"Schema is valid and matches database field types\", function () {\r",
              "    pm.response.to.have.jsonSchema(schema);\r",
              "});\r",
              "\r",
              "pm.test(\"Total price of the product is calculated correctly\", function () {\r",
              "    \r",
              "    // Target the first product in the array\r",
              "    const product = responseJson.products[0];\r",
              "    \r",
              "    // Store quantity and price from the response in variables\r",
              "    const quantity = parseInt(product.quantity, 10);\r",
              "    const price = parseFloat(product.price.replace(/[^0-9.-]+/g, \"\"));\r",
              "    const actualTotal = parseFloat(product.total.replace(/[^0-9.-]+/g, \"\"));\r",
              "    \r",
              "    // Calculate expected total\r",
              "    const calculatedTotal = parseFloat((quantity * price).toFixed(2));\r",
              "    \r",
              "    // Direct comparison\r",
              "    //pm.expect(calculatedTotal).to.equal(actualTotal);\r",
              "      pm.expect(calculatedTotal).to.be.closeTo(price * quantity, 0.01);\r",
              "});\r",
              "\r",
              "   \r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
